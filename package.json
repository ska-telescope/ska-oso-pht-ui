{
  "author": "Stargazers - OMC ART",
  "description": "SKA OSO PHT Application",
  "name": "ska-oso-pht-ui",
  "version": "11.0.0rc1",
  "private": true,
  "license": "BSD 3-Clause",
  "repository": "git@https://gitlab.com/ska-telescope/ska-oso-pht-ui.git",
  "type": "module",
  "exports": {
    ".": {
      "import": "./esm/main.tsx",
      "require": "./main.tsx"
    }
  },
  "scripts": {
    "audit:prod": "yarn npm audit --environment production --recursive",
    "build": "vite build",
    "checker": "yarn prettier:fix && yarn lint:fix",
    "code-analysis": "eslint src -f junit -o linting.xml",
    "remove:cypress:ci": "cypress run --reporter junit --reporter-options 'mochaFile=build/reports/cypress-tests-[hash].xml'",
    "remove:cypress:open": "cypress open",
    "remove:cypress:run": "cypress run --config video=false",
    "remove:cypress:run:component": "cypress run --component --config video=false",
    "dev": "vite",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "local": "vite",
    "merge-component-reports": "jrm build/tests/component-tests.xml \"build/tests/*.xml\"",
    "prettier": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\" \"tests/**/*.{js,jsx,ts,tsx}\"",
    "prettier:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\" \"tests/**/*.{js,jsx,ts,tsx}\"",
    "skao:update": "yarn add @ska-telescope/ska-login-page@latest @ska-telescope/ska-gui-components@latest",
    "start": "vite serve --open --port 6101",
    "test:remove:coverage:report": "npx nyc report --report-dir=build/reports --reporter=html",
    "test:remove:coverage:summary": "npx nyc report --reporter=text-summary",
    "test:remove:headless": "yarn cypress:run",
    "test:remove:component:headless": "cypress run --component --headless --config video=false",
    "test:remove:cypress:e2e:ci": "cypress run --e2e --headless --reporter junit --reporter-options mochaFile=build/tests/unit-tests[hash].xml",
    "test:remove:cypress:component:ci": "cypress run --component --headless --reporter junit --reporter-options mochaFile=build/tests/unit-tests[hash].xml --config video=false",
    "test:remove:e2e:headless": "cypress run --e2e --headless",
    "test:e2e": "cypress run --record --key 4a3a14b8-b3ce-429e-b960-6183c885513e",
    "test:e2e:parallel": "node scripts/cypressParallel.mjs",
    "test:e2e:coverage": "nyc report --report-dir=build/reports --reporter=cobertura",
    "test:e2e:ui": "cypress open",
    "test:unit": "vitest --reporter=junit --outputFile=build/reports/unit-tests.xml --typecheck --coverage --coverage.reportsDirectory=build/coverage",
    "test:unit:coverage": "npx nyc report --report-dir=build/reports --reporter=cobertura",
    "test:unit:ui": "vitest  --coverage --reporter=default --ui",
    "typecheck": "tsc --noEmit"
  },
  "prettier": {
    "printWidth": 100,
    "trailingComma": "none",
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true,
    "jsxSingleQuote": false
  },
  "dependencies": {
    "@azure/msal-browser": "^5.25.0",
    "@azure/msal-react": "^5.7.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/system": "^7.3.11",
    "@mui/x-data-grid": "^7.29.13",
    "@reduxjs/toolkit": "^2.13.0",
    "@ska-telescope/ska-gui-components": "^3.0.0",
    "@ska-telescope/ska-login-page": "^2.0.0",
    "@ska-telescope/skuid": "^3.0.0",
    "axios": "^1.20.0",
    "d3": "^7.9.0",
    "d3-textwrap": "^3.0.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.2",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-latex-next": "^3.0.0",
    "react-pdf": "^11.0.0",
    "react-redux": "^9.3.0",
    "react-router": "^7.18.4",
    "react-router-dom": "^7.18.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-image": "^3.0.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cypress-cucumber-preprocessor": "^4.0.5",
    "@types/d3": "^7.4.3",
    "@types/debug": "^4",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "chokidar": "^5.0.0",
    "cypress": "16.1.1",
    "cypress-file-upload": "^5.0.8",
    "cypress-real-events": "^1.15.1",
    "cypress-split": "^1.25.0",
    "cypress-vite": "^1.10.2",
    "debug": "^4.4.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-formatter-junit": "^9.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "mocha": "^12.0.3",
    "mocha-junit-reporter": "^2.2.1",
    "nyc": "^18.0.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vite-plugin-svgr": "^5.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "resolutions": {
    "diff": "^8.0.3",
    "js-yaml": "^4.3.2",
    "minimatch": "^10.2.3",
    "serialize-javascript": "^7.1.2",
    "systeminformation": "^5.27.14",
    "undici": "^6.23.0"
  },
  "packageManager": "yarn@4.12.0"
}
